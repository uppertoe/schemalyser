{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "A question package, schemalyser-question/1",
 "description": "A clinician's question over the public roles, as the service writes it and the core reads it. The schema uses the subset of JSON Schema that both readers implement: type, enum, const, properties, required, additionalProperties, items, minItems, maxItems, minLength, pattern, minimum, maximum, anyOf and $ref to #/$defs. What the schema cannot say, the reader checks: that the parts are the ones the SQL reads at the contract's versions, that each admission is the contract's, that every capability and proposal is in the catalogue's or the contract's shape, and that every date reads.",
 "type": "object",
 "required": ["format", "title", "contract_version", "statement", "decisions", "capabilities", "question_sql", "parts", "proposals", "produced"],
 "additionalProperties": false,
 "properties": {
  "format": {"const": "schemalyser-question/1"},
  "title": {"type": "string", "minLength": 1, "pattern": "^[^\\n]+$"},
  "contract_version": {"type": "string", "minLength": 1},
  "statement": {
   "type": "object",
   "required": ["cohort", "outcome", "result"],
   "additionalProperties": false,
   "properties": {
    "cohort": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "minLength": 1},
    "result": {"type": "string", "minLength": 1}
   }
  },
  "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
  "examinable": {"$ref": "#/$defs/examinable"},
  "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
  "question_sql": {"type": "string"},
  "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}},
  "proposals": {"type": "array", "items": {"$ref": "#/$defs/proposal"}},
  "note": {"type": "string"},
  "produced": {
   "type": "object",
   "required": ["model", "at"],
   "additionalProperties": false,
   "properties": {
    "model": {"type": "string", "minLength": 1},
    "at": {"type": "string", "minLength": 1},
    "by": {"type": "string"}
   }
  }
 },
 "$defs": {
  "decision": {
   "type": "object",
   "required": ["about", "choice", "decision", "by", "date"],
   "additionalProperties": false,
   "properties": {
    "about": {"type": "string", "minLength": 1},
    "choice": {"type": "string", "minLength": 1},
    "value": {"type": ["number", "string", "boolean", "array", "object", "null"]},
    "unit": {"type": ["string", "null"]},
    "decision": {"type": "string", "minLength": 1},
    "by": {"type": "string", "minLength": 1},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
   }
  },
  "capability": {
   "type": "object",
   "required": ["name", "version", "parameters"],
   "additionalProperties": false,
   "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "integer", "minimum": 1},
    "parameters": {"type": "object"}
   }
  },
  "part": {
   "type": "object",
   "required": ["name", "version", "admission"],
   "additionalProperties": false,
   "properties": {
    "name": {"type": "string", "pattern": "^(role|map)_[a-z][a-z0-9_]*$"},
    "version": {"type": "integer", "minimum": 1},
    "admission": {"enum": ["admitted", "admitted with a ceiling", "refused"]}
   }
  },
  "proposal": {
   "type": "object",
   "required": ["kind", "part", "because", "shape"],
   "additionalProperties": false,
   "properties": {
    "kind": {"enum": ["column", "part"]},
    "part": {"type": "string", "pattern": "^role_[a-z][a-z0-9_]*$"},
    "because": {"type": "string", "minLength": 1},
    "shape": {"type": "object"}
   }
  },
  "window": {
   "type": "object",
   "required": ["from", "to"],
   "additionalProperties": false,
   "properties": {
    "from": {"enum": ["start", "stop"]},
    "from_minutes": {"type": "integer"},
    "to": {"enum": ["start", "stop"]},
    "to_minutes": {"type": "integer"}
   }
  },
  "requirement": {
   "type": "object",
   "required": ["part"],
   "additionalProperties": false,
   "properties": {
    "part": {"type": "string", "pattern": "^role_[a-z][a-z0-9_]*$"},
    "kinds": {"type": "array", "items": {"type": "string"}},
    "flags": {"type": "object"}
   }
  },
  "examinable": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "oracle": {"const": "none"},
    "because": {"type": "string", "minLength": 1},
    "cohort": {
     "type": "object",
     "required": ["grain"],
     "additionalProperties": false,
     "properties": {
      "grain": {"enum": ["anaesthetic", "patient"]},
      "age_days": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": ["integer", "null"]}},
      "period": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}},
      "exclude": {"type": "array", "items": {"enum": ["test_patient", "no_start", "stop_before_start"]}},
      "requires": {"type": "array", "items": {"$ref": "#/$defs/requirement"}}
     }
    },
    "outcome": {
     "type": "object",
     "required": ["part", "measure"],
     "additionalProperties": false,
     "properties": {
      "part": {"type": "string", "pattern": "^role_[a-z][a-z0-9_]*$"},
      "kinds": {"type": "array", "items": {"type": "string"}},
      "forms": {"type": "array", "items": {"type": "string"}},
      "flags": {"type": "object"},
      "window": {"$ref": "#/$defs/window"},
      "measure": {"anyOf": [{"enum": ["exists", "count", "sum", "min", "max", "first_time"]}, {"$ref": "#/$defs/capability"}]},
      "of": {"type": "string"},
      "per": {"type": "string"},
      "duplicates": {"enum": ["collapse", "keep", "lowest", "highest", "first", "last"]},
      "amended": {"enum": ["replaced", "kept"]},
      "absent": {"enum": ["zero", "null", "excluded"]}
     }
    },
    "result": {
     "type": "object",
     "required": ["statistic", "over", "columns"],
     "additionalProperties": false,
     "properties": {
      "statistic": {"enum": ["count", "proportion", "sum", "median", "rows"]},
      "over": {"enum": ["anaesthetic", "patient"]},
      "by": {"type": "array", "items": {"type": "object"}},
      "columns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
     }
    }
   }
  }
 }
}
