<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4295.3"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT r.kind, COUNT(*) AS readings&#xa;FROM (SELECT CASE WHEN CAST(t0.OBS_TYPE_KEY AS varchar(254)) IN (&apos;52&apos;) THEN &apos;map_arterial&apos; ELSE &apos;other&apos; END AS kind, c.anaesthetic_key&#xa;      FROM (SELECT TOP (5000) a.ANAES_KEY AS anaesthetic_key FROM ANAES_RECORD AS a WITH (NOLOCK) ORDER BY a.ANAES_KEY) AS c&#xa;      JOIN OBS_SHEET AS t1 WITH (NOLOCK) ON t1.ANAES_KEY = c.anaesthetic_key&#xa;      JOIN OBS_READING AS t0 WITH (NOLOCK) ON t0.SHEET_KEY = t1.SHEET_KEY) AS r&#xa;GROUP BY r.kind" StatementId="1" StatementCompId="1" StatementType="SELECT" RetrievedFromCache="false" StatementSubTreeCost="0.1559" StatementEstRows="2" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xAD853C62EC11FA40" QueryPlanHash="0xAF16A1F33406B914" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="false" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="88" CompileTime="6" CompileCPU="6" CompileMemory="432"><MemoryGrantInfo SerialRequiredMemory="2048" SerialDesiredMemory="2152" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="41945" EstimatedPagesCached="20972" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="1057040"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-10-09T00:16:44.88" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000001_4222D4EF]" Table="[OBS_READING]" Schema="[dbo]" Database="[invented_world]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-09T00:16:44.89" ModificationCount="0" SamplingPercent