{
  "name": "schemalyser-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-assets": "python3 scripts/prepare_assets.py",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && tsc --noEmit && vite build && node scripts/checksum.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.4",
    "pyodide": "314.0.7",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
