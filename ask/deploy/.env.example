# The model: api reaches Anthropic with the key; cli uses the Claude Code command line on a subscription (development only).
ASK_MODEL_BACKEND=api
ANTHROPIC_API_KEY=
ASK_MODEL=claude-fable-5-1
# Who may see every question rather than their own, comma separated. The admins may always sign in.
ASK_ADMIN_EMAILS=
# Who else may sign in, comma separated. Empty until the owner opens the service to colleagues.
ASK_ALLOWED_EMAILS=
BRAND_NAME=Schemalyser
